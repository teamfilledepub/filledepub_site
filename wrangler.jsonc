{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "filledepub-site",
  "account_id": "03dd02e9004d2deb509bc9456ac17cbf",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/recrutement/",
      "/recrutement/index.html",
      "/theme.css",
      "/api/*",
      "/media/*",
      "/admin",
      "/admin/*",
      "/confidentialite/",
      "/confidentialite/index.html"
    ]
  },
  "main": "src/worker.mjs",
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE_STORE",
        "class_name": "SiteStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-site-store",
      "new_sqlite_classes": [
        "SiteStore"
      ]
    }
  ]
}
